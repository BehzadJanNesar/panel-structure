# Adapter

Translate an external gateway contract into the shop's internal model. The gateway name must not leak into checkout.

```ts
type PaymentPort = {
  pay(orderId: string, amount: number): Promise<{ reference: string }>;
};

function createZarinpalAdapter(client: ZarinpalClient): PaymentPort {
  return {
    pay: async (orderId, amount) => {
      const result = await client.request({ Amount: amount, Description: orderId });
      return { reference: result.authority };
    },
  };
}
```
